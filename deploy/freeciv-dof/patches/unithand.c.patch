+  /* DOF: record the attack by the acting unit itself. A war-time attack gives
+   * no casus belli and therefore no incident, but the ledger needs to know
+   * which unit keeps attacking, not which nation it belongs to. */
+  if (action_has_result(paction, ACTRES_ATTACK)
